@model IEnumerable<Hotel.Data.Data.Employess.Employee>

@{
    ViewData["Title"] = "Employees";
}

<div class="content container-fluid">
    <div class="page-header">
        <div class="row align-items-center">
            <div class="col">
                <h3 class="page-title mt-5">Employees</h3>
            </div>
            <div class="col-auto float-right ml-auto">
                <div class="mt-5">
                    <a asp-action="Create" class="btn btn-primary veiwbutton">Add New Employee</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-12">
            <div class="card card-table">
                <div class="card-body booking_card">
                    <div class="table-responsive">
                        <table class="datatable table table-stripped table-hover table-center mb-0">
                            <thead>
                                <tr>
                                    <th>First Name</th>
                                    <th>Last Name</th>
                                    <th>Login</th>
                                    <th>Hiring Date</th>
                                    <th>Contact</th>
                                    <th>Department</th>
                                    <th>Qualification</th>
                                    <th>Salary</th>
                                    <th class="text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.FirstName</td>
                                        <td>@item.LastName</td>
                                        <td>@item.Login</td>
                                        <td>@item.HiringDate.ToString("dd-MM-yyyy")</td>
                                        <td>@(item.Contact != null ? item.Contact.Address : "Empty")</td>
                                        <td>@(item.Department != null ? item.Department.DepartmentName : "Empty")</td>
                                        <td>@(item.Qualification != null ? item.Qualification.QualificationName : "Empty")</td>
                                        <td>@(item.Salary != null ? item.Salary.SalaryDetails : "Empty")</td>
                                        <td class="text-right">
                                            <div class="dropdown dropdown-action">
                                                <a href="#" class="action-icon dropdown-toggle" data-toggle="dropdown" aria-expanded="false"><i class="fas fa-ellipsis-v ellipse_color"></i></a>
                                                <div class="dropdown-menu dropdown-menu-right">
                                                    <a class="dropdown-item" asp-action="Edit" asp-route-id="@item.EmployeeID"><i class="fas fa-pencil-alt m-r-5"></i> Edit</a>
                                                    <a class="dropdown-item" href="#" onclick="confirmDelete(@item.EmployeeID)"><i class="fas fa-trash-alt m-r-5"></i> Delete</a>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="delete_employee" class="modal fade delete-modal" role="dialog">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body text-center">
                <h3 class="delete_class">Are you sure?</h3>
                <div class="m-t-20">
                    <a href="#" class="btn btn-white" data-dismiss="modal">Close</a>
                    <button type="button" class="btn btn-danger" onclick="deleteEmployee()">Delete</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function confirmDelete(id) {
            $('#delete_employee').modal('show');
            window.deleteEmployee = function () {
                window.location.href = '/Employee/Delete/' + id;
            }
        }
    </script>
}
