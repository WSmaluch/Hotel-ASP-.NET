@model Hotel.Data.Data.Employess.Employee

@{
    ViewData["Title"] = "Edit";
}

<div class="content container-fluid">
    <div class="page-header">
        <div class="row align-items-center">
            <div class="col">
                <h3 class="page-title mt-5">Edit Employee</h3>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-12">
            <form asp-action="Edit">
                <div asp-validation-summary="All" class="text-danger"></div>
                <input type="hidden" asp-for="EmployeeID" />
                <div class="row formtype">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Name</label>
                            <input asp-for="FirstName" class="form-control" />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Last Name</label>
                            <input asp-for="LastName" class="form-control" />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Hiring Date</label>
                            <input asp-for="HiringDate" class="form-control" type="date" />
                            <span asp-validation-for="HiringDate" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Contact</label>
                            <div class="input-group">
                                <select asp-for="ContactId" class="form-control" asp-items="ViewBag.ContactId"></select>
                                <div class="input-group-append">
                                    <a href="#" class="btn btn-primary" id="addContact">
                                        <i class="fas fa-plus"></i>
                                    </a>
                                </div>
                            </div>
                            <span asp-validation-for="ContactId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Department</label>
                            <div class="input-group">
                                <select asp-for="DepartmentId" class="form-control" asp-items="ViewBag.DepartmentId"></select>
                                <div class="input-group-append">
                                    <a href="#" class="btn btn-primary" id="addDepartment">
                                        <i class="fas fa-plus"></i>
                                    </a>
                                </div>
                            </div>
                            <span asp-validation-for="DepartmentId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Qualification</label>
                            <div class="input-group">
                                <select asp-for="QualificationId" class="form-control" asp-items="ViewBag.QualificationId"></select>
                                <div class="input-group-append">
                                    <a href="#" class="btn btn-primary" id="addQualification">
                                        <i class="fas fa-plus"></i>
                                    </a>
                                </div>
                            </div>
                            <span asp-validation-for="QualificationId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Salary</label>
                            <div class="input-group">
                                <select asp-for="SalaryId" class="form-control" asp-items="ViewBag.SalaryId"></select>
                                <div class="input-group-append">
                                    <a href="#" class="btn btn-primary" id="addSalary">
                                        <i class="fas fa-plus"></i>
                                    </a>
                                </div>
                            </div>
                            <span asp-validation-for="SalaryId" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <input type="submit" value="Save" class="btn btn-primary buttonedit ml-2" />
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {
            $('#addContact').click(function () {
                window.location.href = '/Contact/Create';
            });

            $('#addDepartment').click(function () {
                window.location.href = '/Department/Create';
            });

            $('#addQualification').click(function () {
                window.location.href = '/Qualifications/Create';
            });

            $('#addSalary').click(function () {
                window.location.href = '/Salary/Create';
            });
        });
    </script>
}
