@model Hotel.Data.Data.Booking.Reservation

@{
    ViewData["Title"] = "Create Reservation";
}

<div class="content container-fluid">
    <div class="page-header">
        <div class="row align-items-center">
            <div class="col">
                <h3 class="page-title mt-5">Create Reservation</h3>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-12">
            <form asp-action="Confirm" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="row formtype">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Room</label>
                            <select asp-for="RoomId" class="form-control" asp-items="ViewBag.Rooms"></select>
                            <span asp-validation-for="RoomId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Select Option</label>
                            <select asp-for="OptionId" class="form-control" asp-items="ViewBag.Options"></select>
                            <span asp-validation-for="OptionId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>First Name</label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Last Name</label>
                            <input asp-for="LastName" class="form-control" />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Email</label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Phone Number</label>
                            <input asp-for="PhoneNumber" class="form-control" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>City</label>
                            <input asp-for="City" class="form-control" />
                            <span asp-validation-for="City" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Address</label>
                            <input asp-for="AdressFirstLine" class="form-control" />
                            <span asp-validation-for="AdressFirstLine" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Postal Code</label>
                            <input asp-for="PostalCode" class="form-control" />
                            <span asp-validation-for="PostalCode" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Check-In Date</label>
                            <input type="text" class="form-control" value="@((ViewBag.CheckIn as DateTime?)?.ToString("dd-MM-yyyy"))" readonly />
                            <input type="hidden" asp-for="CheckIn" />
                            <span asp-validation-for="CheckIn" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Check-Out Date</label>
                            <input type="text" class="form-control" value="@((ViewBag.CheckOut as DateTime?)?.ToString("dd-MM-yyyy"))" readonly />
                            <input type="hidden" asp-for="CheckOut" />
                            <span asp-validation-for="CheckOut" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Number of Adults</label>
                            <input type="text" class="form-control" value="@ViewBag.NumberOfAdults.ToString()" readonly />
                            <input type="hidden" asp-for="NumberOfAdults" />
                            <span asp-validation-for="NumberOfAdults" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Number of Children</label>
                            <input type="text" class="form-control" value="@ViewBag.NumberOfChildren.ToString()" readonly />
                            <input type="hidden" asp-for="NumberOfChildren" />
                            <span asp-validation-for="NumberOfChildren" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Special Requests</label>
                            <input asp-for="SpecialRequests" class="form-control" />
                            <span asp-validation-for="SpecialRequests" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary buttonedit ml-2">Create</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
