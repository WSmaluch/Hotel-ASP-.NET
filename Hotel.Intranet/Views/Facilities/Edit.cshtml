@model Hotel.Data.Data.Booking.Extensions.Facilities

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Facilities</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="IdFacility" />
            <div class="form-group">
                <label>Facility name</label>
                <input asp-for="NameFacility" class="form-control" />
                <span asp-validation-for="NameFacility" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
