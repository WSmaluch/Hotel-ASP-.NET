@model Hotel.Data.Data.CMS.Attractions.Attraction

@{
    ViewData["Title"] = "Edit";
}

<div class="content container-fluid">
    <div class="page-header">
        <div class="row align-items-center">
            <div class="col">
                <h3 class="page-title mt-5">Edit Attraction</h3>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-12">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />
                <div class="row formtype">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Name</label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Description</label>
                            <input asp-for="Description" class="form-control" />
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>PhotosURL</label>
                            <input type="file" class="form-control-file" id="photoFile" name="photoFile">
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>More Info Url</label>
                            <input asp-for="MoreInfoUrl" class="form-control" />
                            <span asp-validation-for="MoreInfoUrl" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Attraction Type</label>
                            <select asp-for="AttractionTypeId" class="form-control" asp-items="ViewBag.AttractionTypeId"></select>
                            <span asp-validation-for="AttractionTypeId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Attraction Price</label>
                            <select asp-for="AttractionPriceId" class="form-control" asp-items="ViewBag.AttractionPriceId"></select>
                            <span asp-validation-for="AttractionPriceId" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <input type="submit" value="Save" class="btn btn-primary buttonedit ml-2" />
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
