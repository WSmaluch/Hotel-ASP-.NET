@model Hotel.Data.Data.CMS.Attractions.Attraction

@{
    ViewData["Title"] = "Create";
}

<div class="content container-fluid">
    <div class="page-header">
        <div class="row align-items-center">
            <div class="col">
                <div class="mt-5">
                    <h4 class="card-title float-left mt-2">Add Attraction</h4>
                    <a asp-action="Create" class="btn btn-primary float-right veiwbutton">Add Attraction</a>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-12">
            <form asp-action="Create" enctype="multipart/form-data">
                <div class="row formtype">
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label>Name</label>
                                        <input asp-for="Name" class="form-control" />
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label>Description</label>
                                        <input asp-for="Description" class="form-control" />
                                    </div>
                                </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>PhotosURL</label>
                            <input type="file" class="form-control-file" id="photoFile" name="photoFile">
                        </div>
                    </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label>More Info URL</label>
                                        <input asp-for="MoreInfoUrl" class="form-control" />
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label>Attraction Type</label>
                                        <select asp-for="AttractionTypeId" class="form-control" asp-items="ViewBag.AttractionTypeId"></select>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label>Attraction Price</label>
                                        <select asp-for="AttractionPriceId" class="form-control" asp-items="ViewBag.AttractionPriceId"></select>
                                    </div>
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary buttonedit ml-2">Save</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
            $('#addContentItems').click(function () {
                window.location.href = '/ContentItem/Create';
            });
        });
    </script>
}
