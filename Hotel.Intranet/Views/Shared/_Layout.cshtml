                                <li><a asp-area="" asp-controller="Employee" asp-action="Index">Employees</a></li>
                                <li><a asp-area="" asp-controller="Employee" asp-action="Create">Add Employee</a></li>
                                <li><a asp-area="" asp-controller="Salary" asp-action="Index">Salary</a></li>
                                <li><a asp-area="" asp-controller="Salary" asp-action="Create">Add Salary</a></li>
