                                <li class="submenu">
                                    <a href="#"><i class="fas fa-info-circle"></i> <span> Restaurant Information </span> <span class="menu-arrow"></span></a>
                                    <ul class="submenu_class" style="display: none;">
                                        <li><a href="@Url.Action("Index", "RestaurantCategory")">Restaurant Categories</a></li>
                                        <li><a href="@Url.Action("Index", "RestaurantPage")">Restaurant Pages</a></li>
                                        <li><a href="@Url.Action("Index", "RestaurantSchedule")">Restaurant Schedule</a></li>
                                    </ul>
                                </li>
                                <!-- Dishes -->
                                <li class="submenu">
                                    <a href="#"><i class="fas fa-utensils"></i> <span> Dishes </span> <span class="menu-arrow"></span></a>
                                    <ul class="submenu_class" style="display: none;">
                                        <li><a href="@Url.Action("Index", "Dish")">Dishes</a></li>
                                        <li><a href="@Url.Action("Index", "DishPrice")">Dish Prices</a></li>
                                        <li><a href="@Url.Action("Index", "Ingredient")">Ingredients</a></li>
                                        <li><a href="@Url.Action("Index", "NutritionInfo")">Nutrition Information</a></li>
                                        <li><a href="@Url.Action("Index", "SpecialDiet")">Special Diets</a></li>
                                    </ul>
                                </li>
