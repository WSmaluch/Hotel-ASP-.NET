	<script>
		function hide() {
			var logoTextDiv = document.getElementById('logoclass');
			if (logoTextDiv.style.display === 'none') {
				logoTextDiv.style.display = 'block';
			} else {
				logoTextDiv.style.display = 'none';
			}
		}

	</script>
	<script data-cfasync="false" src="../../../cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script>
	<script src="~/lib/bootstrap/js/jquery-3.5.1.min.js"></script>
	<script src="~/lib/bootstrap/js/popper.min.js"></script>
	<script src="~/lib/bootstrap/js/bootstrap.min.js"></script>
	<script src="~/lib/bootstrap/plugins/slimscroll/jquery.slimscroll.min.js"></script>
	<script src="~/lib/bootstrap/plugins/raphael/raphael.min.js"></script>
	<script src="~/lib/bootstrap/plugins/morris/morris.min.js"></script>
	<script src="~/lib/bootstrap/js/chart.morris.js"></script>
	<script src="~/lib/bootstrap/js/script.js"></script>
	@await RenderSectionAsync("Scripts", required:false)
