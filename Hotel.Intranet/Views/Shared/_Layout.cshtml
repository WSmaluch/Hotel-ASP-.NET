                                <li><a href="@Url.Action("Create", "Gallery")">Add Gallery</a></li>
                            </ul>
                        </li>

                        <!-- Restaurant -->
                        <li class="submenu">
                            <a href="#"><i class="fas fa-bread-slice" aria-hidden="true"></i> <span> Restaurant </span> <span class="menu-arrow"></span></a>
                            <ul class="submenu_class" style="display: none;">
                                <!-- Events -->
                                <li class="submenu">
                                    <a href="#"><i class="fas fa-calendar-alt"></i> <span> Events </span> <span class="menu-arrow"></span></a>
