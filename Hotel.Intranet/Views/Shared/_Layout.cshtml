				<div style="padding-top:7%;font-weight:bold;letter-spacing:5px;font-family:sans-serif;">
					<span id="logoclass" style="display:block;color:black;">TRAPISE<br/>RESORT</span>
				</div>
					@*<a asp-area="" asp-controller="Home" asp-action="Index" class="logo logo-small"> <img src="https://i.imgur.com/MR7xXf3.png" alt="Logo" width="30" height="30"> </a>*@
				</div>
			</a>
			<a href="javascript:void(0);" id="toggle_btn" onclick="hide()"> <i class="fe fe-text-align-left"></i> </a>
			<a class="mobile_btn" id="mobile_btn"> <i class="fas fa-bars"></i> </a>
		</div>
