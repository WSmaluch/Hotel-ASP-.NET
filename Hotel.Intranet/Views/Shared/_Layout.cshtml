                                        <li><a asp-area="" asp-controller="Reservations" asp-action="Index">Reservations</a></li>
                                        <li><a asp-area="" asp-controller="Reservations" asp-action="CreateReservationDate">Create Reservation</a></li>
                                    </ul>
                                </li>
                                <!-- Offers -->
