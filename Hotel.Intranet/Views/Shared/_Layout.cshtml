<!DOCTYPE html>
<html>
	<style></style>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0">
	<title>Hotel Dashboard Template</title>
	<link rel="shortcut icon" type="~/lib/bootstrap/image/x-icon" href="img/favicon.png">
	<link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css">
	<link rel="stylesheet" href="~/lib/bootstrap/plugins/fontawesome/css/fontawesome.min.css">
	<link rel="stylesheet" href="~/lib/bootstrap/plugins/fontawesome/css/all.min.css">
	<link rel="stylesheet" href="~/lib/bootstrap/css/feathericon.min.css">
	<link rel="stylehseet" href="https://cdn.oesmith.co.uk/morris-0.5.1.css">
