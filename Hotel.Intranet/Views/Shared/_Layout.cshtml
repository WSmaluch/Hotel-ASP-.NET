                                    <a href="#"><i class="fas fa-door-open"></i> <span> Rooms </span> <span class="menu-arrow"></span></a>
                                    <ul class="submenu_class" style="display: none;">
                                        <li><a href="@Url.Action("Index","Rooms")">All Rooms</a></li>
                                        <li><a href="@Url.Action("Create","Rooms")">Add Rooms</a></li>
                                    </ul>
                                </li>
                                <!-- Room Pricing -->
                                <li class="submenu">
                                    <a href="#"><i class="far fa-money-bill-alt"></i> <span> Room Pricing </span> <span class="menu-arrow"></span></a>
