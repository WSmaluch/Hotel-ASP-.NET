@model Hotel.Data.Data.Booking.Extensions.Types

@{
    ViewData["Title"] = "Edit Type";
}

<div class="content container-fluid">
    <div class="page-header">
        <div class="row align-items-center">
            <div class="col">
                <h3 class="page-title mt-5">Edit Type</h3>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-12">
            <form asp-action="Edit" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="IdType" />
                <div class="row formtype">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Name</label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Description</label>
                            <input asp-for="Description" class="form-control" />
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Size</label>
                            <input asp-for="Size" class="form-control" />
                            <span asp-validation-for="Size" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Max Amount Of People</label>
                            <input asp-for="MaxAmountOfPeople" class="form-control" />
                            <span asp-validation-for="MaxAmountOfPeople" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Photo</label>
                            <div>
                                <img src="@Model.PhotosURL" class="img-fluid mb-2" alt="Current photo" style="max-width: 100%; max-height: 200px;" />
                                <input type="file" class="form-control-file" id="photoFile" name="photoFile">
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <h4>Selected Facilities</h4>
                            <ul>
                                @foreach (var facility in Model.Facilities)
                                {
                                    <li>@facility.NameFacility</li>
                                }
                            </ul>
                        </div>
                        
                    </div>
                    
                </div>
                <button type="submit" class="btn btn-primary buttonedit ml-2">Save</button>
                <a asp-action="EditFacilities" asp-route-id="@Model.IdType" class="btn btn-primary buttonedit ml-2" style="background-color:gray">Edit Facilities</a>
                <div class="col-md-4 mt-3">
                </div>
            </form>

        </div>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
