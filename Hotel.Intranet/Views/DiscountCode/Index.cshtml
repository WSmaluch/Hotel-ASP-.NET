@model IEnumerable<Hotel.Data.Data.Booking.DiscountCode>

@{
    ViewData["Title"] = "Discount Codes";
}

<div class="content container-fluid">
    <div class="page-header">
        <div class="row align-items-center">
            <div class="col">
                <h3 class="page-title mt-5">Discount Codes</h3>
            </div>
            <div class="col">
                <div class="text-right">
                    <a asp-action="Create" class="btn btn-primary">Create New Discount Code</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Code</th>
                                    <th>Discount (%)</th>
                                    <th>Valid From</th>
                                    <th>Valid To</th>
                                    <th>Active</th>
                                    <th class="text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@Html.DisplayFor(modelItem => item.Code)</td>
                                        <td>@Html.DisplayFor(modelItem => item.Discount)</td>
                                        <td>@item.ValidFrom.ToShortDateString()</td>
                                        <td>@item.ValidTo.ToShortDateString()</td>
                                        <td>@Html.DisplayFor(modelItem => item.IsActive)</td>
                                        <td class="text-right">
                                            <div class="dropdown dropdown-action">
                                                <a href="#" class="action-icon dropdown-toggle" data-toggle="dropdown" aria-expanded="false"><i class="fas fa-ellipsis-v"></i></a>
                                                <div class="dropdown-menu dropdown-menu-right">
                                                    <a class="dropdown-item" asp-action="Edit" asp-route-id="@item.IdDiscountCode"><i class="fas fa-pencil-alt m-r-5"></i> Edit</a>
                                                    <a class="dropdown-item" href="#" onclick="confirmDelete(@item.IdDiscountCode)"><i class="fas fa-trash-alt m-r-5"></i> Delete</a>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div id="delete_asset" class="modal fade delete-modal" role="dialog">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body text-center">
                <h3 class="delete_class">Are you sure?</h3>
                <div class="m-t-20">
                    <a href="#" class="btn btn-white" data-dismiss="modal">Close</a>
                    <button type="button" class="btn btn-danger" onclick="deleteConfirm()">Delete</button>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        var idToDelete;

        function confirmDelete(id) {
            idToDelete = id;
            $('#delete_asset').modal('show');
        }

        function deleteConfirm() {
            window.location.href = '/DiscountCode/Delete/' + idToDelete;
        }
    </script>

}
