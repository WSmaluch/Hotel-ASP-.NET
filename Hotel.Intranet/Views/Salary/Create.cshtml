@model Hotel.Data.Data.Employess.Salary

@{
    ViewData["Title"] = "Create";
}

<div class="content container-fluid">
    <div class="page-header">
        <div class="row align-items-center">
            <div class="col">
                <h3 class="page-title mt-5">Add Salary</h3>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-12">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="row formtype">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Salary Amount</label>
                            <input asp-for="SalaryAmount" class="form-control" data-val="false"/>
                            <span asp-validation-for="SalaryAmount" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Salary Details</label>
                            <input asp-for="SalaryDetails" class="form-control" />
                            <span asp-validation-for="SalaryDetails" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-primary buttonedit ml-2">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var SalaryInput = document.querySelector("#SalaryAmount");

        SalaryInput.addEventListener("input", function () {
            validateDecimalInput(SalaryInput);
        });

        // Replace dots with commas before form submission
        var form = document.querySelector("form");
        form.addEventListener("submit", function () {
            replaceDotsWithCommas(SalaryInput);
        });

        function replaceDotsWithCommas(inputElement) {
            var value = inputElement.value.trim();
            var newValue = value.replace(/\./g, ",");
            inputElement.value = newValue;
        }
    });
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
