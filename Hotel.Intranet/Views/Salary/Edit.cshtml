@model Hotel.Data.Data.Employess.Salary

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Salary</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="SalaryID" />
            <div class="form-group">
                <label>Salary Amount</label>
                <input asp-for="SalaryAmount" class="form-control" data-val="false"/>
                <span asp-validation-for="SalaryAmount" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Salary Details</label>
                <input asp-for="SalaryDetails" class="form-control" />
                <span asp-validation-for="SalaryDetails" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var SalaryInput = document.querySelector("#SalaryAmount");

        SalaryInput.addEventListener("input", function () {
            validateDecimalInput(SalaryInput);
        });

        // Replace dots with commas before form submission
        var form = document.querySelector("form");
        form.addEventListener("submit", function () {
            replaceDotsWithCommas(SalaryInput);
        });

        function replaceDotsWithCommas(inputElement) {
            var value = inputElement.value.trim();
            var newValue = value.replace(/\./g, ",");
            inputElement.value = newValue;
        }
    });
</script>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
