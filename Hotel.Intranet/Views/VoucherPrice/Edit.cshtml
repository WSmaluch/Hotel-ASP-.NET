@model Hotel.Data.Data.CMS.Voucher.VoucherPrice

@{
    ViewData["Title"] = "Edit";
}

<div class="content container-fluid">
    <div class="page-header">
        <div class="row align-items-center">
            <div class="col">
                <h3 class="page-title mt-5">Edit Voucher Price</h3>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-12">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />
                <div class="row formtype">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Amount</label>
                            <input asp-for="Amount" class="form-control" />
                            <span asp-validation-for="Amount" class="text-danger" data-val="false"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Valid From</label>
                            <input asp-for="ValidFrom" class="form-control" type="date" />
                            <span asp-validation-for="ValidFrom" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Valid To</label>
                            <input asp-for="ValidTo" class="form-control" type="date" />
                            <span asp-validation-for="ValidTo" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <input type="submit" value="Save" class="btn btn-primary buttonedit ml-2" />
                </div>
            </form>
        </div>
    </div>
</div>


<script>
    document.addEventListener("DOMContentLoaded", function () {
        var amountInput = document.querySelector("#Amount");

        // Replace dots with commas before form submission
        var form = document.querySelector("form");
        form.addEventListener("submit", function () {
            replaceDotsWithCommas(amountInput);
        });

        function replaceDotsWithCommas(inputElement) {
            var value = inputElement.value.trim();
            var newValue = value.replace(/\./g, ",");
            inputElement.value = newValue;
        }
    });
</script>