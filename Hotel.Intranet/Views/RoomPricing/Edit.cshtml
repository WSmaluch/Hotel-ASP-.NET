@model Hotel.Data.Data.Booking.RoomPricing

@{
    ViewData["Title"] = "Edit";
    System.Threading.Thread.CurrentThread.CurrentCulture = new System.Globalization.CultureInfo("pl-PL");
}

<div class="content container-fluid">
    <div class="page-header">
        <div class="row align-items-center">
            <div class="col">
                <h3 class="page-title mt-5">Edit Room Pricing</h3>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-12">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="PricingId" />
                <div class="row formtype">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Room Type</label>
                            <select asp-for="TypeId" class="form-control" asp-items="ViewBag.TypeId" data-val="false"></select>
                            <span asp-validation-for="TypeId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Valid From</label>
                            <input asp-for="ValidFrom" class="form-control" type="date" />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Valid To</label>
                            <input asp-for="ValidTo" class="form-control" type="date" />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Base price for a night</label>
                            <input asp-for="BasePriceAdult" class="form-control" data-val="false" />
                            <span asp-validation-for="BasePriceAdult" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Additional price for a night</label>
                            <input asp-for="BasePriceChildren" class="form-control" data-val="false" />
                            <span asp-validation-for="BasePriceChildren" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary buttonedit ml-2">Save</button>
            </form>
            <button class="btn btn-danger mt-2" onclick="confirmDelete(@Model.PricingId)">Delete</button>
        </div>
    </div>
</div>


<script>
    function confirmDelete(pricingId) {
        var result = confirm("Are you sure?");
        if (result) {
            window.location.href = '/RoomPricing/Delete/' + pricingId;
        }
    }

    document.addEventListener("DOMContentLoaded", function () {
        var basePriceAdultInput = document.querySelector("#BasePriceAdult");
        var basePriceChildrenInput = document.querySelector("#BasePriceChildren");

        // Replace dots with commas before form submission
        var form = document.querySelector("form");
        form.addEventListener("submit", function () {
            replaceDotsWithCommas(basePriceAdultInput);
            replaceDotsWithCommas(basePriceChildrenInput);
        });

        function replaceDotsWithCommas(inputElement) {
            var value = inputElement.value.trim();
            var newValue = value.replace(/\./g, ",");
            inputElement.value = newValue;
        }
    });
</script>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}