@using System.Globalization;
@{
    CultureInfo.CurrentCulture = new CultureInfo("en-US");
    CultureInfo.CurrentUICulture = new CultureInfo("en-US");
    bool isEvenRow = false;
    var selectedRoomTypeId = ViewBag.SelectedRoomTypeId;
    var currentMonth = ViewBag.CurrentMonth ?? DateTime.Now.Month;
    var currentYear = ViewBag.CurrentYear ?? DateTime.Now.Year;
    var daysInMonth = DateTime.DaysInMonth(currentYear, currentMonth);
    var firstDayOfMonth = new DateTime(currentYear, currentMonth, 1);
    var lastDayOfMonth = new DateTime(currentYear, currentMonth, daysInMonth);
    var currentDayOfWeek = (int)firstDayOfMonth.DayOfWeek;
}
@model IEnumerable<Hotel.Data.Data.Booking.RoomPricing>

@{
    ViewData["Title"] = "Index";
}

<h1 id="monthTitle">Index</h1>

<style>
    .col-md-12 {
        margin-left: -22%;
        font-size: small;
        float: left;
    }

    body {
        overflow-x: scroll;
    }

    .price-cell {
    }

    #monthName {
        text-align: center;
    }

    td img {
        width: 30%;
    }

    #monthNavigation {
        text-align: center;
        margin-bottom: 20px;
    }

    #monthNavigation button {
        margin: 5px;
    }

    #calendar {
        margin-left: 20%; 
    }

    .form-group {
        margin-left: 20%;
    }

    .date-cell {
        padding: 10px;
        transition: background-color 0.3s ease;
        margin-top:10px;
    }

    .highlight {
        background-color: lightblue; /* Możesz zmienić kolor na dowolny */
    }

</style>
<div class="page-header">
</div>
<div class="container">
    <div class="row">
        <div class="col-md-12 scrollable-table"> 
            <div>
                <div style="float:left;width:50%">
                    <div class="row align-items-center">
                        <div class="col" style="margin-top:-1%">
                            <div class="mt-5">
                                <a asp-action="Create" class="btn btn-primary float-left veiwbutton " style="margin-right:3%">Add new pricing</a>
                            </div>
                        </div>
                    </div>
                </div>
                <div style="width:30%;float:left;">
                    <div id="monthNavigation">
                        <button onclick="changeMonth(-1)">Previous</button>
                        <h1 id="monthTitle">@firstDayOfMonth.ToString("MMMM yyyy")</h1>
                        <button onclick="changeMonth(1)">Next</button>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <form method="get" action="@Url.Action("Index", "RoomPricing")">
                    <select id="roomType" name="selectedRoomTypeId" class="form-control">
                        <option value="">-- Select Room Type --</option>
                        @foreach (var roomType in ViewBag.RoomTypes as List<SelectListItem>)
                        {
                            if (ViewBag.SelectedRoomTypeId != null && roomType.Value == ViewBag.SelectedRoomTypeId.ToString())
                            {
                                <option value="@roomType.Value" selected="selected">
                                    @roomType.Text
                                </option>
                            }
                            else
                            {
                                <option value="@roomType.Value">
                                    @roomType.Text
                                </option>
                            }
                        }
                    </select>
                    <br />
                    <button type="submit" class="btn btn-primary">Filter</button>
                    <input type="hidden" name="month" value="@ViewBag.CurrentMonth" />
                    <input type="hidden" name="year" value="@ViewBag.CurrentYear" />
                </form>
            </div>


            @* <div id="editForm" style="display:none;">
                <form id="monthEditForm" asp-action="Edit">
                    <label>Select a month:</label>
                    <select id="monthSelector" class="form-control">
                        @foreach (var roomPricing in Model)
                        {
                            <option value="@roomPricing.PricingId">
                                @roomPricing.Type.Name - @roomPricing.ValidFrom.ToString("dd/MM/yyyy") to @roomPricing.ValidTo.ToString("dd/MM/yyyy")
                            </option>
                        }
                    </select>
                    <button type="button" onclick="submitForm()" class="btn btn-primary">Edit</button>
                </form>
            </div> *@
            <div id="calendar">
            @if (selectedRoomTypeId != null)
            {
                var filteredRoomPricings = Model.Where(rp => rp.TypeId == selectedRoomTypeId).ToList();
                if (filteredRoomPricings.Any())
                {
                    //<a asp-action="Edit" asp-route-id="@filteredRoomPricings.FirstOrDefault()?.PricingId">Edit</a>
                    <table class="table table-bordered">
                        <thead class="table-header">
                            <tr>
                                <th colspan="7">@firstDayOfMonth.ToString("MMMM yyyy")</th>
                            </tr>
                            <tr>
                                <th>Mon</th>
                                <th>Tue</th>
                                <th>Wed</th>
                                <th>Thu</th>
                                <th>Fri</th>
                                <th>Sat</th>
                                <th>Sun</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int row = 0; row < 6; row++) 
                            {
                                <tr>
                                    @for (int col = 0; col < 7; col++)
                                    {
                                        var currentDay = firstDayOfMonth.AddDays(row * 7 + col - currentDayOfWeek + 1);
                                        <td style="height:100px">
                                            
                                            @if (currentDay.Month == firstDayOfMonth.Month)
                                            {
                                                <div style="text-align:center;background-color:lightgray;border-bottom-left-radius: 3px; border-bottom-right-radius: 3px;margin:-8px -8px 0px -8px">@currentDay.Day</div>
                                                    <div class="price-cell" >
                                                        @foreach (var roomPricing in filteredRoomPricings.Where(rp => rp.ValidFrom <= currentDay && rp.ValidTo >= currentDay))
                                                        {
                                                            <div class="date-cell" onclick="redirectToEdit('@roomPricing.PricingId')" data-pricing-id="@roomPricing.PricingId">
                                                                <b>@roomPricing.BasePriceAdult</b><br />
                                                                <b>@roomPricing.BasePriceChildren</b>
                                                            </div>
                                                        }
                                                    </div>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p>No entries for this month.</p>
                }
            }
            else
            {
                <p>Please select a room type to display the calendar.</p>
            }
        </div>
        </div>
    </div>
</div>

<script>
    var currentMonth = new Date(@currentYear, @currentMonth - 1, 1);


    function changeMonth(offset) {
        currentMonth.setMonth(currentMonth.getMonth() + offset);
        var url = '/RoomPricing/Index?month=' + (currentMonth.getMonth() + 1) + '&year=' + currentMonth.getFullYear() + '&selectedRoomTypeId=' + document.getElementById('roomType').value;
        window.location.href = url;
    }

    document.getElementById("editButton").addEventListener("click", function () {
        editFormVisible = !editFormVisible;
        document.getElementById("editForm").style.display = editFormVisible ? "block" : "none";
    });

    var editFormVisible = false;

    function submitForm() {
        var selectedId = document.getElementById('monthSelector').value;
        if (selectedId) {
            window.location.href = '/RoomPricing/Edit/' + selectedId;
        }
    }

</script>
<script>
    function redirectToEdit(pricingId) {
        var url = '/RoomPricing/Edit/' + pricingId;
        window.location.href = url;
    }

    document.querySelectorAll('.date-cell').forEach(cell => {
        cell.addEventListener('mouseenter', function () {
            var pricingId = this.getAttribute('data-pricing-id');
            document.querySelectorAll('[data-pricing-id="' + pricingId + '"]').forEach(el => {
                el.classList.add('highlight');
            });
        });

        cell.addEventListener('mouseleave', function () {
            var pricingId = this.getAttribute('data-pricing-id');
            document.querySelectorAll('[data-pricing-id="' + pricingId + '"]').forEach(el => {
                el.classList.remove('highlight');
            });
        });
    });
</script>