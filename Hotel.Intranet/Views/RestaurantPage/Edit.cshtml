@model Hotel.Data.Data.Restaurant.RestaurantPage

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>RestaurantPage</h4>
<hr />
<div class="content container-fluid">
    <div class="row">
        <div class="col-lg-12">
            <div class="card card-table">
                <div class="card-body booking_card">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="IdAboutPage" />

                        <div class="col-md-4">
                            <div class="form-group">
                                <label>BannerUrl</label><br />
                                <img src="@Model.BannerUrl" class="img-fluid mb-2" alt="Current photo" style="max-width: 100%; max-height: 200px;" />
                                <input type="file" class="form-control-file" id="BannerUrl" name="BannerUrl">
                            </div>
                        </div>
                        <div class="form-group">
                            <label asp-for="BannerTitle" class="control-label">Banner Title</label>
                            <input asp-for="BannerTitle" class="form-control" />
                            <span asp-validation-for="BannerTitle" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Content1Title" class="control-label">Content 1 Title</label>
                            <input asp-for="Content1Title" class="form-control" />
                            <span asp-validation-for="Content1Title" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Content1Description" class="control-label">Content 1 Description</label>
                            <input asp-for="Content1Description" class="form-control" />
                            <span asp-validation-for="Content1Description" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Content1Picture1Url</label><br />
                                <img src="@Model.Content1Picture1Url" class="img-fluid mb-2" alt="Current photo" style="max-width: 100%; max-height: 200px;" />
                                <input type="file" class="form-control-file" id="Content1Picture1Url" name="Content1Picture1Url">
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Content1Picture2Url</label><br />
                                <img src="@Model.Content1Picture2Url" class="img-fluid mb-2" alt="Current photo" style="max-width: 100%; max-height: 200px;" />
                                <input type="file" class="form-control-file" id="Content1Picture2Url" name="Content1Picture2Url">
                            </div>
                        </div>
                        <div class="form-group">
                            <label asp-for="Content2Title" class="control-label">Content 2 Title</label>
                            <input asp-for="Content2Title" class="form-control" />
                            <span asp-validation-for="Content2Title" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Content2Description" class="control-label">Content 2 Description</label>
                            <input asp-for="Content2Description" class="form-control" />
                            <span asp-validation-for="Content2Description" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Content3Title" class="control-label">Content 3 Title</label>
                            <input asp-for="Content3Title" class="form-control" />
                            <span asp-validation-for="Content3Title" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Content3Description" class="control-label">Content 3 Description</label>
                            <input asp-for="Content3Description" class="form-control" />
                            <span asp-validation-for="Content3Description" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <button type="submit" class="btn btn-primary buttonedit ml-2">Create</button>
                            <a asp-action="Index" class="btn btn-secondary ml-2">Back to List</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
