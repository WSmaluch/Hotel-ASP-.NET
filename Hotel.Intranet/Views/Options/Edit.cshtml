@model Hotel.Data.Data.Booking.Options

@{
    ViewData["Title"] = "Edit";
}

<div class="content container-fluid">
    <div class="page-header">
        <div class="row align-items-center">
            <div class="col">
                <h3 class="page-title mt-5">Edit Option</h3>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-12">
            <form asp-action="Edit" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="IdOption" />
                <div class="row formtype">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Name</label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Price</label>
                            <input asp-for="Price" class="form-control" />
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>StartDate</label>
                            <input asp-for="StartDate" class="form-control" type="date" />
                            <span asp-validation-for="StartDate" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>EndDate</label>
                            <input asp-for="EndDate" class="form-control" type="date" />
                            <span asp-validation-for="EndDate" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>ContentItems</label>
                            <div class="input-group">
                                <select asp-for="ContentItems" class="form-control" multiple asp-items="ViewBag.ContentItems"></select>
                                <div class="input-group-append">
                                    <a href="#" class="btn btn-primary" id="editContentItems">
                                        <i style="margin-top:35px" class="fas fa-plus"></i>
                                    </a>
                                </div>
                            </div>
                            <span asp-validation-for="ContentItems" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>PhotosURL</label>
                            <div>
                                <img src="@Model.PhotoUrl" class="img-fluid mb-2" alt="Current photo" style="max-width: 100%; max-height: 200px;" />
                                <input type="file" class="form-control-file" id="photoFile" name="photoFile">
                            </div>
                        </div>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary buttonedit ml-2">Save</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
            $('#editContentItems').click(function () {
                window.location.href = '/ContentItem/Create';
            });
        });
    </script>
}
