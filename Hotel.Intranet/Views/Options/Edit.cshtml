@model Hotel.Data.Data.Booking.Options

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Options</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="IdOption" />
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label class="control-label">Photo</label>
                <div>
                    <img src="@Model.PhotoUrl" class="img-fluid" alt="Your image" style="max-width: 100%; max-height: 200px;" />
                </div>
            </div>
            <div class="form-group">
                <label class="control-label">Photo</label>
                <div>
                    <input type="file" id="photoFile" name="photoFile" class="form-control-file">
                    <img id="imagePreview" src="#" alt="Your image" style="display:none; max-width: 100%; max-height: 200px;" />
                </div>
            </div>
            <div class="form-group">
                <label asp-for="Price" class="control-label"></label>
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="StartDate" class="control-label"></label>
                <input asp-for="StartDate" class="form-control" />
                <span asp-validation-for="StartDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EndDate" class="control-label"></label>
                <input asp-for="EndDate" class="form-control" />
                <span asp-validation-for="EndDate" class="text-danger"></span>
            </div>
            @if (ViewBag.Content != null)
            {
                <div class="col-md-4">
                    <h4>Selected Content Items</h4>
                    <ul>
                        @foreach (var item in ViewBag.Content)
                        {
                            <li>@item.Title</li>
                        }
                    </ul>
                </div>
            }
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
        <div class="col-md-4">
            <a asp-action="EditContentItems" asp-route-id="@Model.IdOption" class="btn btn-secondary">Edit Content Items</a>
        </div>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
