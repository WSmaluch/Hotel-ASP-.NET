@model IEnumerable<Hotel.Data.Data.CMS.Site_Guid.SiteGuide>

@{
    ViewData["Title"] = "Guest Information";
}

<!-- bradcam_area_start -->
<div class="bradcam_area breadcam_bg" style="background-image:url(https://i.imgur.com/ccGTCmJ.png)">
    <h3>Guest Information</h3>
</div>
<!-- bradcam_area_end -->

<!--================ Services Area =================-->
<section class="services_area section-padding">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="main_title">
                    <h2>Our Services</h2>
                    <p>Discover our range of services designed to make your stay comfortable.</p>
                </div>
            </div>
        </div>
        <div class="row">
            @foreach (var item in ViewBag.SiteGuide)
            {
                <div class="col-md-6">
                    <div class="single_attraction">
                        <h4></h4>
                        <div class="attraction_thumb">
                            <img src="@item.Image" alt="No photo" style="max-width: 100%; height: 550px;">
                        </div>
                        <div class="attraction_info">
                            <h4>@item.Title</h4>
                            <p>@item.Description</p>
                            <p>@item.Details</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
<!--================ Services Area =================-->