@{
    ViewData["Title"] = "Attractions";
}
<style>
    .attractions_area .attractions_left_sidebar .single_attraction {
        margin-bottom: 30px; 
        position: relative;
        padding-bottom: 50px;
        min-height: 400px; 
        padding-left: 15px;
        padding-right: 15px;
    }

        .attractions_area .attractions_left_sidebar .single_attraction .attraction_thumb {
            width: 100%;
            height: 200px; 
            overflow: hidden;
        }

            .attractions_area .attractions_left_sidebar .single_attraction .attraction_thumb img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .attractions_area .attractions_left_sidebar .single_attraction .attraction_info {
            padding-top: 15px; 
        }

            .attractions_area .attractions_left_sidebar .single_attraction .attraction_info h4 {
                margin-top: 10px;
            }

            .attractions_area .attractions_left_sidebar .single_attraction .attraction_info p {
                margin-top: 10px;
            }

            .attractions_area .attractions_left_sidebar .single_attraction .attraction_info a {
                margin-top: 10px;
                position: absolute;
                bottom: 10px; 
            }
</style>
<div class="bradcam_area breadcam_bg" style="background-image:url(https://i.imgur.com/ccGTCmJ.png)">
    <h3>Attractions</h3>
</div>
<section class="attractions_area section-padding">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="attractions_left_sidebar">
                    <div class="row">
                        @foreach (var attraction in ViewBag.Attractions)
                        {
                            <div class="col-md-6">
                                <div class="single_attraction">
                                    <h4></h4>
                                    <div class="attraction_thumb">
                                        <img src="@attraction.ImageUrl" alt="No photo">
                                    </div>
                                    <div class="attraction_info">
                                            <h4>@attraction.Name</h4>
                                        <p>@attraction.Description</p>
                                        @if (attraction.AttractionPrice != null)
                                        {
                                            <p>Price for our guests:<strong> @attraction.AttractionPrice.Price</strong></p>
                                        }
                                        <a href="@attraction.MoreInfoUrl" class="btn btn-primary">Learn more</a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
