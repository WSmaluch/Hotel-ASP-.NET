@{
    ViewData["Title"] = "Blog";
}
<!-- bradcam_area_start -->
<div class="bradcam_area breadcam_bg" style="background-image:url(https://i.imgur.com/ccGTCmJ.png)">
    <h3>blog</h3>
</div>
<!-- bradcam_area_end -->
<!--================Blog Area =================-->
<section class="blog_area section-padding">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 mb-5 mb-lg-0">
                <div class="blog_left_sidebar">
                    @await Html.PartialAsync("PartialViews/Posts",(IEnumerable<Hotel.Data.Data.CMS.Blog.Post>)ViewBag.Posts)


                    
                </div>
            </div>
            <div class="col-lg-4">
                <div class="blog_right_sidebar">
                    

                    <aside class="single_sidebar_widget popular_post_widget">
                        <h3 class="widget_title">Recent Post</h3>
                        @await Html.PartialAsync("PartialViews/RecentPosts",(IEnumerable<Hotel.Data.Data.CMS.Blog.Post>)ViewBag.Posts)
                    </aside>
                    
                </div>
            </div>
        </div>
    </div>
</section>
<!--================Blog Area =================-->